 abstract = {Separating resolved and unresolved sources in large imaging surveys is a fundamental step to enable downstream science, such as searching for extragalactic transients in wide-field time-domain surveys. Here we present our method to effectively separate point sources from the resolved, extended sources in the Dark Energy Spectroscopic Instrument (DESI) Legacy Surveys (LS). We develop a supervised machine-learning model based on the Gradient Boosting algorithm {\textbackslash}texttt\{XGBoost\}. The features input to the model are purely morphological and are derived from the tabulated LS data products. We train the model using \${\textbackslash}sim\$\$2{\textbackslash}times10{\textasciicircum}5\$ LS sources in the COSMOS field with HST morphological labels and evaluate the model performance on LS sources with spectroscopic classification from the DESI Data Release 1 (\${\textbackslash}sim\$\$2{\textbackslash}times10{\textasciicircum}7\$ objects) and the Sloan Digital Sky Survey Data Release 17 (\${\textbackslash}sim\$\$3{\textbackslash}times10{\textasciicircum}6\$ objects), as well as on \${\textbackslash}sim\$\$2{\textbackslash}times10{\textasciicircum}8\$ Gaia stars. A significant fraction of LS sources are not observed in every LS filter, and we therefore build a ``Hybrid'' model as a linear combination of two {\textbackslash}texttt\{XGBoost\} models, each containing features combining aperture flux measurements from the ``blue'' (\$gr\$) and ``red'' (\$iz\$) filters. The Hybrid model shows a reasonable balance between sensitivity and robustness, and achieves higher accuracy and flexibility compared to the LS morphological typing. With the Hybrid model, we provide classification scores for \${\textbackslash}sim\$\$3{\textbackslash}times10{\textasciicircum}9\$ LS sources, making this the largest ever machine-learning catalog separating resolved and unresolved sources. The catalog has been incorporated into the real-time pipeline of the La Silla Schmidt Southern Survey (LS4), enabling the identification of extragalactic transients within the LS4 alert stream.},
 author = {Liu, Chang and Miller, Adam A. and Bloom, Joshua S. and Knop, Robert A. and Nugent, Peter E.},
 doi = {10.48550/arXiv.2505.17174},
 keywords = {Astrophysics - Instrumentation and Methods for Astrophysics},
 month = {May},
 note = {arXiv:2505.17174 [astro-ph]},
 publisher = {arXiv},
 shorttitle = {A {Morphological} {Model} to {Separate} {Resolved}--unresolved {Sources} in the {DESI} {Legacy} {Surveys}},
 title = {A {Morphological} {Model} to {Separate} {Resolved}--unresolved {Sources} in the {DESI} {Legacy} {Surveys}: {Application} in the {LS4} {Alert} {Stream}},
 url = {http://arxiv.org/abs/2505.17174},
 urldate = {2025-07-07},
 year = {2025}
}

