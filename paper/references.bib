@article{TaCi2014,
 abstract = {We use the Sloan Digital Sky Survey II Supernova Survey (SDSS-II SNS) data to measure the volumetric core collapse supernova (CCSN) rate in the redshift range (0.03 < z < 0.09). Using a sample of 89 CCSN, we find a volume-averaged rate of 1.06 Â± 0.19 Ã 10â4((h/0.7)3/(yr Mpc3)) at a mean redshift of 0.072 Â± 0.009. We measure the CCSN luminosity function from the data and consider the implications on the star formation history.},
